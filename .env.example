DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=api.vedhikareturngift.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://vedhikareturngift.com,https://www.vedhikareturngift.com
FRONTEND_URL=https://vedhikareturngift.com
REFRESH_SECRET=replace-with-refresh-secret

# PostgreSQL database connection (required)
DATABASE_URL=postgresql://postgres:postgresql@127.0.0.1:5432/vedhika_brand
DATABASE_SSLMODE=prefer

# Razorpay payment gateway credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: set this to use Google Maps instead of the default no-key OSM/OSRM service.
GOOGLE_MAPS_API_KEY=
DELIVERY_STORE_ADDRESS="Door No. 4/77/A, Happy Down, Salaiyar, Nandhavanapatty, Old Karur Road, Dindigul - 624 005, India"
DELIVERY_STORE_FALLBACK_ADDRESS="Dindigul 624005, Tamil Nadu, India"

# Optional SMTP settings. In development, password reset emails print to the terminal.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=VEDHIKA BRAND <no-reply@example.invalid>
